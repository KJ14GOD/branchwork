{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node --experimental-strip-types *)",
      "Bash(node --env-file=.env --experimental-strip-types *)",
      "Bash(env -u ANTHROPIC_API_KEY *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git worktree list*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s --max-time * http://127.0.0.1:*)",
      "Bash(pkill -f src/worker.ts)",
      "Bash(pkill -f src/demo.ts)",
      "Bash(pkill -f vite)",
      "Bash(pkill -f Electron)",
      "Bash(./scripts/gate.sh)",
      "Bash(./scripts/fleet.sh *)",
      "Bash(./scripts/contract-lock.sh *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/contract-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking the contract lock"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/stop-gate.sh",
            "timeout": 180,
            "statusMessage": "Checking the gate"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
