# Dependencies
node_modules/
.pnpm-store/

# Agent configuration. The shared rules live in .claude/settings.json and are
# committed on purpose, so a fresh worktree inherits them. Only the personal
# file is ignored, and it is ignored here rather than only in a global gitignore
# so the rule survives a clone onto another machine.
.claude/settings.local.json
.fleet-task

# Build output
dist/
out/
build/
.vite/

# Test output
coverage/
test-results/
playwright-report/

# Environment and secrets
.env
.env.*
!.env.example

# Local databases and runtime state
*.db
*.db-shm
*.db-wal
.novus/

# Logs
*.log

# Operating systems and editors
.DS_Store
.idea/
.vscode/

# TypeScript
*.tsbuildinfo
dist-electron/
