{
  "name": "@novus/desktop",
  "private": true,
  "version": "0.0.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "package": "electron-builder --mac dmg",
    "package:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.novus.desktop",
    "productName": "Novus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist-renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@novus/contracts": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cross-spawn": "^7.0.6",
    "simple-icons": "^16.27.1",
    "smol-toml": "^1.7.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "pg": "^8.22.0",
    "playwright": "^1.54.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  }
}
