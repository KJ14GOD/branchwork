{
  "name": "@novus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The local Novus coding-agent worker.",
  "scripts": {
    "start": "node --env-file=../../.env --experimental-strip-types src/worker.ts",
    "demo": "node --experimental-strip-types src/demo.ts",
    "smoke:openai": "node --env-file=../../.env --experimental-strip-types src/openai-smoke.ts",
    "test": "node --experimental-strip-types --test 'src/*.test.ts'",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@novus/contracts": "workspace:*",
    "@novus/session-service": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "openai": "^7.1.0"
  }
}
